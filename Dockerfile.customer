# Customer（Vite SPA → nginx）
# docker build -f Dockerfile.customer -t ctp-customer .
# docker run --rm -p 3002:80 ctp-customer
FROM node:20-alpine AS builder
RUN corepack enable && corepack prepare pnpm@10.30.3 --activate
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/portal/package.json ./apps/portal/
COPY apps/ops/package.json ./apps/ops/
COPY apps/customer/package.json ./apps/customer/
COPY packages/styles/package.json ./packages/styles/
COPY packages/api-catalog/package.json ./packages/api-catalog/

RUN pnpm install --frozen-lockfile

COPY packages/styles ./packages/styles
COPY packages/api-catalog ./packages/api-catalog
COPY apps/customer ./apps/customer

RUN pnpm --filter @ctp/customer build

FROM nginx:1.27-alpine AS runner
COPY docker/nginx-spa.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/customer/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
