{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Brand Color System · 基于 #0053A2 的三色场（前台门户 / 客户后台 / 运营后台）配色方案 · 风格定位：新锐与稳重并重。格式遵循 W3C Design Tokens Community Group (DTCG) 规范。",
  "color": {
    "brand": {
      "$description": "品牌核心色板：主蓝（稳重基石） + 极光青（新锐张力） + 锐意橙（点睛 CTA）",
      "primary": {
        "$description": "主蓝 · 源自品牌基准色 #0053A2（600 档）。承载信任、专业、稳重。",
        "50":  { "$value": "#EAF2FB", "$type": "color" },
        "100": { "$value": "#D3E4F6", "$type": "color" },
        "200": { "$value": "#A8C7EC", "$type": "color" },
        "300": { "$value": "#74A4DD", "$type": "color" },
        "400": { "$value": "#3F7CC5", "$type": "color" },
        "500": { "$value": "#0B62B8", "$type": "color", "$description": "亮主蓝：前台门户主行动色，更有活力" },
        "600": { "$value": "#0053A2", "$type": "color", "$description": "品牌基准色：后台系统主行动色，白底对比度约 7.6:1（AAA）" },
        "700": { "$value": "#004281", "$type": "color" },
        "800": { "$value": "#003161", "$type": "color" },
        "900": { "$value": "#002244", "$type": "color" },
        "950": { "$value": "#00162E", "$type": "color" }
      },
      "accent": {
        "$description": "极光青 · 新锐感的来源。用于科技感动效、焦点态、数据高亮、渐变末端。注意：500 档以下不作正文文字色。",
        "50":  { "$value": "#E6FAFB", "$type": "color" },
        "100": { "$value": "#C1F2F5", "$type": "color" },
        "200": { "$value": "#8BE4EA", "$type": "color" },
        "300": { "$value": "#4ED3DD", "$type": "color" },
        "400": { "$value": "#19C0CE", "$type": "color" },
        "500": { "$value": "#00B8C6", "$type": "color", "$description": "极光青基准：图形/大元素/焦点环专用" },
        "600": { "$value": "#0096A3", "$type": "color", "$description": "可作白字底色的最浅档位" },
        "700": { "$value": "#007580", "$type": "color" },
        "800": { "$value": "#00575F", "$type": "color" },
        "900": { "$value": "#003D43", "$type": "color" }
      },
      "spot": {
        "$description": "锐意橙 · 克制的点睛色。仅用于前台关键 CTA、限时标记、运营后台重点预警。全站用量 ≤5%。",
        "50":  { "$value": "#FFF4E8", "$type": "color" },
        "100": { "$value": "#FFE3C7", "$type": "color" },
        "500": { "$value": "#F97316", "$type": "color" },
        "600": { "$value": "#E8620C", "$type": "color" },
        "700": { "$value": "#C24E08", "$type": "color" }
      }
    },
    "neutral": {
      "$description": "冷调中性灰 · 带轻微蓝相，与主蓝同频，避免纯灰的沉闷。",
      "0":   { "$value": "#FFFFFF", "$type": "color" },
      "50":  { "$value": "#F7F9FC", "$type": "color" },
      "100": { "$value": "#EFF2F7", "$type": "color" },
      "200": { "$value": "#E2E7EF", "$type": "color" },
      "300": { "$value": "#CBD3E0", "$type": "color" },
      "400": { "$value": "#98A4B7", "$type": "color" },
      "500": { "$value": "#6B7889", "$type": "color" },
      "600": { "$value": "#4A5665", "$type": "color" },
      "700": { "$value": "#363F4D", "$type": "color" },
      "800": { "$value": "#252C37", "$type": "color" },
      "900": { "$value": "#161C24", "$type": "color" },
      "950": { "$value": "#0C1118", "$type": "color" }
    },
    "semantic": {
      "$description": "功能语义色：成功 / 警告 / 危险 / 信息，三场景通用。",
      "success": {
        "100": { "$value": "#E2F6EA", "$type": "color" },
        "500": { "$value": "#16A34A", "$type": "color" },
        "600": { "$value": "#0F8A3D", "$type": "color" },
        "700": { "$value": "#0B6B30", "$type": "color" }
      },
      "warning": {
        "100": { "$value": "#FEF1DC", "$type": "color" },
        "500": { "$value": "#F79009", "$type": "color" },
        "600": { "$value": "#D97706", "$type": "color" },
        "700": { "$value": "#B45309", "$type": "color" }
      },
      "danger": {
        "100": { "$value": "#FCEBEB", "$type": "color" },
        "500": { "$value": "#E5484D", "$type": "color" },
        "600": { "$value": "#D23439", "$type": "color" },
        "700": { "$value": "#A9262B", "$type": "color" }
      },
      "info": {
        "100": { "$value": "{color.brand.primary.100}", "$type": "color" },
        "500": { "$value": "{color.brand.primary.500}", "$type": "color" },
        "600": { "$value": "{color.brand.primary.600}", "$type": "color" },
        "700": { "$value": "{color.brand.primary.700}", "$type": "color" }
      }
    },
    "chart": {
      "$description": "数据可视化序列色：由主蓝 → 极光青 → 锐意橙发散，兼顾区分度与品牌感。",
      "1": { "$value": "{color.brand.primary.500}", "$type": "color" },
      "2": { "$value": "{color.brand.accent.500}",  "$type": "color" },
      "3": { "$value": "{color.brand.spot.500}",    "$type": "color" },
      "4": { "$value": "{color.brand.primary.300}", "$type": "color" },
      "5": { "$value": "{color.brand.accent.300}",  "$type": "color" },
      "6": { "$value": "{color.semantic.success.500}", "$type": "color" },
      "7": { "$value": "{color.semantic.warning.500}", "$type": "color" },
      "8": { "$value": "{color.neutral.400}", "$type": "color" }
    }
  },
  "gradient": {
    "$description": "品牌渐变：新锐感的核心表达，主蓝向极光青过渡。",
    "hero-portal": {
      "$type": "gradient",
      "$description": "前台门户首屏主视觉渐变：稳重起笔，新锐收尾",
      "$value": [
        { "color": "{color.brand.primary.800}", "position": 0 },
        { "color": "{color.brand.primary.500}", "position": 0.55 },
        { "color": "{color.brand.accent.500}",  "position": 1 }
      ]
    },
    "accent-flow": {
      "$type": "gradient",
      "$description": "短渐变：按钮高亮、进度条、插画装饰",
      "$value": [
        { "color": "{color.brand.primary.500}", "position": 0 },
        { "color": "{color.brand.accent.500}",  "position": 1 }
      ]
    }
  },
  "theme": {
    "$description": "三场景语义 alias：同一色板，三种性格。门户更亮更活，客户后台清爽高效，运营后台沉稳密集。",
    "portal": {
      "$description": "前台门户 · 对外形象窗口。用色最亮：主行动用 500 亮蓝，首屏用大渐变，锐意橙点睛关键转化按钮。",
      "bg": {
        "page":    { "$value": "{color.neutral.0}",  "$type": "color" },
        "subtle":  { "$value": "{color.neutral.50}", "$type": "color" },
        "hero":    { "$value": "{gradient.hero-portal}", "$type": "color" },
        "footer":  { "$value": "{color.brand.primary.900}", "$type": "color" }
      },
      "text": {
        "primary":   { "$value": "{color.neutral.900}", "$type": "color" },
        "secondary": { "$value": "{color.neutral.500}", "$type": "color" },
        "inverse":   { "$value": "{color.neutral.0}",   "$type": "color" }
      },
      "action": {
        "primary": {
          "default": { "$value": "{color.brand.primary.500}", "$type": "color" },
          "hover":   { "$value": "{color.brand.primary.600}", "$type": "color" },
          "active":  { "$value": "{color.brand.primary.700}", "$type": "color" }
        },
        "cta": {
          "default": { "$value": "{color.brand.spot.500}", "$type": "color", "$description": "关键转化按钮（注册/购买），锐意橙点睛" },
          "hover":   { "$value": "{color.brand.spot.600}", "$type": "color" }
        }
      },
      "link": {
        "default": { "$value": "{color.brand.primary.500}", "$type": "color" },
        "hover":   { "$value": "{color.brand.primary.600}", "$type": "color" }
      },
      "border": {
        "default": { "$value": "{color.neutral.200}", "$type": "color" }
      },
      "focus": {
        "ring": { "$value": "{color.brand.accent.400}", "$type": "color", "$description": "焦点环用极光青：可访问性场景里的新锐签名" }
      }
    },
    "customer": {
      "$description": "客户后台 · 用户日常工作台。清爽克制：浅灰页面底 + 白色卡片，主行动用 600 品牌基准蓝。",
      "bg": {
        "page":    { "$value": "{color.neutral.50}", "$type": "color" },
        "surface": { "$value": "{color.neutral.0}",  "$type": "color" },
        "sidebar": { "$value": "{color.neutral.0}",  "$type": "color" },
        "header":  { "$value": "{color.neutral.0}",  "$type": "color" }
      },
      "text": {
        "primary":   { "$value": "{color.neutral.900}", "$type": "color" },
        "secondary": { "$value": "{color.neutral.500}", "$type": "color" },
        "inverse":   { "$value": "{color.neutral.0}",   "$type": "color" }
      },
      "nav": {
        "active-bg":   { "$value": "{color.brand.primary.50}",  "$type": "color" },
        "active-text": { "$value": "{color.brand.primary.700}", "$type": "color" },
        "text":        { "$value": "{color.neutral.600}",       "$type": "color" }
      },
      "action": {
        "primary": {
          "default": { "$value": "{color.brand.primary.600}", "$type": "color" },
          "hover":   { "$value": "{color.brand.primary.500}", "$type": "color" },
          "active":  { "$value": "{color.brand.primary.700}", "$type": "color" }
        }
      },
      "link": {
        "default": { "$value": "{color.brand.primary.600}", "$type": "color" },
        "hover":   { "$value": "{color.brand.primary.500}", "$type": "color" }
      },
      "border": {
        "default": { "$value": "{color.neutral.200}", "$type": "color" },
        "strong":  { "$value": "{color.neutral.300}", "$type": "color" }
      },
      "focus": {
        "ring": { "$value": "{color.brand.primary.400}", "$type": "color" }
      }
    },
    "ops": {
      "$description": "运营后台 · 内部高密度作业系统。最沉稳：深色侧边导航 + 中性灰页面，主蓝压暗一档，信息层级靠灰阶而非色彩。",
      "bg": {
        "page":    { "$value": "{color.neutral.100}", "$type": "color" },
        "surface": { "$value": "{color.neutral.0}",   "$type": "color" },
        "sidebar": { "$value": "{color.neutral.900}", "$type": "color", "$description": "深色侧边栏：运营后台的稳重签名" }
      },
      "sidebar": {
        "text":        { "$value": "{color.neutral.300}", "$type": "color" },
        "text-active": { "$value": "{color.neutral.0}",   "$type": "color" },
        "active-bg":   { "$value": "#FFFFFF1A", "$type": "color", "$description": "白色 10% 透明叠加" },
        "accent-bar":  { "$value": "{color.brand.accent.500}", "$type": "color", "$description": "选中项左侧 3px 极光青指示条" }
      },
      "text": {
        "primary":   { "$value": "{color.neutral.900}", "$type": "color" },
        "secondary": { "$value": "{color.neutral.500}", "$type": "color" },
        "inverse":   { "$value": "{color.neutral.0}",   "$type": "color" }
      },
      "action": {
        "primary": {
          "default": { "$value": "{color.brand.primary.600}", "$type": "color" },
          "hover":   { "$value": "{color.brand.primary.700}", "$type": "color" },
          "active":  { "$value": "{color.brand.primary.800}", "$type": "color" }
        },
        "critical": {
          "default": { "$value": "{color.semantic.danger.500}", "$type": "color", "$description": "高危操作（删除/下线）" },
          "hover":   { "$value": "{color.semantic.danger.600}", "$type": "color" }
        }
      },
      "border": {
        "default": { "$value": "{color.neutral.300}", "$type": "color" }
      },
      "table": {
        "stripe": { "$value": "{color.neutral.50}", "$type": "color" },
        "header-bg": { "$value": "{color.neutral.100}", "$type": "color" }
      },
      "focus": {
        "ring": { "$value": "{color.brand.primary.400}", "$type": "color" }
      }
    }
  }
}
