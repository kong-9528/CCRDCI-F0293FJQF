  "articles": [
    {
      "id": "1001",
      "category": "FAQ",
      "title": "什么是 DCI 数字版权唯一标识符？",
      "content": "DCI (Digital Copyright Identifier) 是数字空间中唯一的版权身份证和权益凭证，由中国版权保护中心统一发码与管理，实现版权的可信存照与全网确权。",
      "summary": null,
      "coverImage": null,
      "sortOrder": 1,
      "status": "PUBLISHED",
      "auditStatus": "PASS",
      "createdAt": "2026-10-12 17:23:25",
      "updatedAt": "2026-10-24 05:03:54"
    },
    {
      "id": "1002",
      "category": "FAQ",
      "title": "DCI 体系是什么？",
      "content": "DCI体系是以DCI国家标准为引领，以标准化标识为基础手段，以AI、区块链等新技术的系统集成应用为驱动，涵盖标准、技术协议、产品服务、新型数智基础设施和生态联盟于一体的体系化解决方案。",
      "summary": null,
      "coverImage": null,
      "sortOrder": 2,
      "status": "PUBLISHED",
      "auditStatus": "PASS",
      "createdAt": "2026-10-12 17:23:25",
      "updatedAt": "2026-10-12 17:23:25"
    },
    {
      "id": "1003",
      "category": "FAQ",
      "title": "如何申请成为 DCI 注册中心？",
      "content": "具备互联网平台运营资格与数据治理能力的企事业单位，均可通过主页“如何申请成为 DCI 注册中心”在线提交主体资质材料，经评估认证后签订合作协议。",
      "summary": null,
      "coverImage": null,
      "sortOrder": 3,
      "status": "PUBLISHED",
      "auditStatus": "PASS",
      "createdAt": "2026-10-12 17:23:25",
      "updatedAt": "2026-10-12 17:23:25"
    },
    {
      "id": "1004",
      "category": "FAQ",
      "title": "DCI 存照凭证具备司法法律效力吗？",
      "content": "具备。DCI 体系融合了区块链不可篡改技术与国家级时间戳校验，存储结果直接对接司法存证链，在知识产权维权诉讼中具备权威证据效力。",
      "summary": null,
      "coverImage": null,
      "sortOrder": 4,
      "status": "PUBLISHED",
      "auditStatus": "PASS",
      "createdAt": "2026-10-12 17:23:25",
      "updatedAt": "2026-10-12 17:23:25"
    },
    {
      "id": "1005",
      "category": "FAQ",
      "title": "DCI 申领业务都支持哪些作品？",
      "content": "著作权法规定的作品均支持，包括文字作品；音乐、戏剧、曲艺、舞蹈作品；美术、建筑作品；摄影作品；视听作品；计算机软件；符合作品特征的其他智力成果（如数据集、AI生成内容等）。",
      "summary": null,
      "coverImage": null,
      "sortOrder": 5,
      "status": "PUBLISHED",
      "auditStatus": "PASS",
      "createdAt": "2026-10-12 17:23:25",
      "updatedAt": "2026-10-12 17:23:25"
    }
  ],
